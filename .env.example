# Copy to .env.local for local dev. In production these are set in the
# Vercel dashboard (Project Settings → Environment Variables) — never commit
# real values.

# Telegram bot token from @BotFather. Rotate the old one before using it here
# — it was previously committed in plaintext to a local config file.
TELEGRAM_BOT_TOKEN=

# The channel/chat id signals get posted to.
TELEGRAM_CHAT_ID=

# Random shared secret — required in the X-Scan-Secret header to trigger
# /api/scan. Generate with: openssl rand -hex 32
SCAN_SECRET=

# Random shared secret passed to Telegram's setWebhook as `secret_token`;
# Telegram echoes it back on every webhook call so we can verify the request.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public — safe to expose to the browser. The Telegram channel invite link
# used by the landing page CTA.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/REPLACE_ME
